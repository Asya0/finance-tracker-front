{
   "compilerOptions": {
      "ignoreDeprecations": "6.0",
      "composite": true,
      "noEmit": true,
      "emitDeclarationOnly": false,
      "target": "es2022",
      "module": "esnext",
      "moduleResolution": "bundler",
      "allowImportingTsExtensions": true,
      "verbatimModuleSyntax": true,
      "skipLibCheck": true
   },
   "include": ["vite.config.ts"]
}
